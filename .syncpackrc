{
  "versionGroups": [
    {
      "label": "packages/zql-benchmarks/rn is an Expo app that is deliberately not a pnpm workspace member (see packages/replicache-perf/rn/README.md). It pins the React, TypeScript and Expo versions its React Native release needs, independently of the workspace's.",
      "packages": [
        "zql-benchmarks-rn"
      ],
      "isIgnored": true
    },
    {
      "label": "packages/replicache-perf/rn is an Expo app that is deliberately not a pnpm workspace member (see its README). It pins the React, TypeScript and Expo versions its React Native release needs, independently of the workspace's.",
      "packages": [
        "replicache-perf-rn"
      ],
      "isIgnored": true
    },
    {
      "label": "zero-swift's CLI (packages/zero-swift-cli) reads schemas with the TypeScript compiler API at runtime, which TypeScript 7 does not have",
      "dependencies": [
        "typescript"
      ],
      "packages": [
        "zero-swift"
      ],
      "pinVersion": "6.0.3"
    },
    {
      "label": "zero-swift's CLI takes the app's @rocicorp/zero, any release it supports, not the workspace's",
      "dependencies": [
        "@rocicorp/zero"
      ],
      "dependencyTypes": [
        "peer"
      ],
      "packages": [
        "zero-swift"
      ],
      "isIgnored": true
    },
    {
      "label": "replicache-doc stays on TypeScript 6 because typedoc does not support TypeScript 7",
      "dependencies": [
        "typescript"
      ],
      "packages": [
        "replicache-doc"
      ],
      "pinVersion": "~6.0.2"
    }
  ],
  "semverGroups": [
    {
      "range": "~",
      "dependencies": [
        "typescript"
      ],
      "packages": [
        "**"
      ]
    }
  ]
}
