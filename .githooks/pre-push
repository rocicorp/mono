#!/usr/bin/env bash
# Block pushes that put customer app data into the logs.
#
# LOG_LEAK_REVIEW=0 disables the review; "warn" makes it advisory.
set -uo pipefail

mode=${LOG_LEAK_REVIEW:-block}
[ "$mode" = 0 ] && exit 0

remote=${1:-origin}
root=$(git rev-parse --show-toplevel)
review="$root/tools/log-leak-review/review.sh"
[ -x "$review" ] || exit 0

zero=0000000000000000000000000000000000000000
blocked=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue

  base=$remote_sha
  if [ "$base" = "$zero" ]; then
    base=$(git merge-base "$remote/HEAD" "$local_sha" 2>/dev/null) \
      || base=$(git merge-base "$remote/main" "$local_sha" 2>/dev/null) \
      || continue
  fi
  [ "$base" = "$local_sha" ] && continue

  echo "log-leak-review: checking $base..$local_sha" >&2
  out=$("$review" "$base..$local_sha")
  rc=$?
  [ -z "$out" ] || printf '%s\n' "$out" >&2

  case $rc in
    0) ;;
    1) [ "$mode" = warn ] || blocked=1 ;;
    *) echo "log-leak-review: skipped, pushing anyway." >&2 ;;
  esac
done

[ "$blocked" = 0 ] && exit 0

cat >&2 <<'MSG'
Push blocked: the diff appears to log customer application data.
Fix the findings or use git push --no-verify for a false positive.
MSG
exit 1
