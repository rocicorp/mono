{
  "name": "zbugs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check-types": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.scripts.json",
    "check-types:client:watch": "tsc -p tsconfig.json --watch",
    "check-types:server:watch": "tsc -p tsconfig.node.json --watch",
    "db-up": "cd docker && docker compose up",
    "db-down": "cd docker && docker compose down",
    "db-migrate": "drizzle-kit migrate",
    "db-seed": "node scripts/seed.ts",
    "change-log-traffic": "node scripts/change-log-traffic.ts",
    "build-litestream": "bash scripts/build-litestream.sh",
    "rmv2-soak": "node scripts/rmv2-soak.ts",
    "generate-templates": "node scripts/generate-templates.ts",
    "generate-synthetic": "NODE_OPTIONS='--max-old-space-size=8192' node scripts/generate-synthetic.ts",
    "db-seed-synthetic": "ZERO_SEED_DATA_DIR=db/seed-data/synthetic node scripts/seed.ts",
    "clean": "cd docker && docker compose down && docker volume rm docker_zbugs_pgdata_sync && docker volume rm docker_zbugs_pgdata_upstream && rm -rf /tmp/zbugs-sync-replica.db*",
    "format": "oxfmt --config ../../.oxfmtrc.json .",
    "check-format": "oxfmt --config ../../.oxfmtrc.json --check .",
    "lint": "oxlint --quiet --config ../../oxlint.config.ts src/ scripts/",
    "preview": "vite preview",
    "zero": "node --trace-warnings ../../packages/zero-cache/src/server/runner/main.ts",
    "zero-cache-compare": "ZERO_LOG_LEVEL=debug ZERO_CHANGE_STREAMER_SQLITE_CHANGE_LOG_MODE=compare ZERO_CHANGE_STREAMER_SQLITE_CHANGE_LOG_COMPARE_PERCENT=100 ZERO_CHANGE_STREAMER_SQLITE_CHANGE_LOG_RETENTION_MS=60000 node ../../packages/zero-cache/src/server/runner/main.ts",
    "zero-cache-dev": "node ../../packages/zero/src/zero-cache-dev.ts",
    "zero-brk": "node --inspect-brk ../../packages/zero-cache/src/server/debug/single.ts",
    "transform-query": "node ../../packages/zero-cache/src/scripts/transform-query.ts",
    "run-query": "node ../../packages/zero-cache/src/scripts/run-query.ts",
    "run-query-brk": "node --inspect-brk ../../packages/zero-cache/src/scripts/run-query.ts",
    "create-keys": "node ../../packages/zero-cache/src/scripts/create-jwk.ts",
    "dev-token": "node scripts/dev-token.ts",
    "analyze-query": "node scripts/analyze.ts",
    "test": "cd ../../packages/zero && pnpm run build && cd ../../apps/zbugs && vitest run --config vitest.config.ts --project zbugs/no-pg",
    "test:watch": "vitest --config vitest.config.ts --project zbugs/no-pg",
    "analyze": "analyze -c vite.config.ts",
    "test:pg": "vitest run --config vitest.config.ts --project zbugs/pg-16",
    "test:pg:watch": "vitest --config vitest.config.ts --project zbugs/pg-16",
    "fmt": "oxfmt .",
    "check-fmt": "oxfmt --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@dotenvx/dotenvx": "^1.66.0",
    "@faker-js/faker": "^10.6.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/oauth2": "^8.2.0",
    "@floating-ui/react": "^0.26.28",
    "@headlessui/react": "^2.2.10",
    "@octokit/core": "^6.1.6",
    "@rocicorp/zero": "workspace:*",
    "@rocicorp/zero-virtual": "0.7.0",
    "@schickling/fps-meter": "^0.1.2",
    "classnames": "^2.5.1",
    "compare-utf8": "^0.2.3",
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "fastify": "^5.12.7",
    "jose": "^5.10.0",
    "js-cookie": "^3.0.7",
    "nanoid": "^5.1.16",
    "pg": "^8.20.0",
    "postgres": "3.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^14.4.1",
    "react-markdown": "^9.1.0",
    "react-textarea-autosize": "^8.5.9",
    "react-toastify": "^10.0.6",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "use-debounce": "^10.1.1",
    "usehooks-ts": "^3.1.1",
    "wouter": "^3.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rocicorp/logger": "^6.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/hast": "^3.0.4",
    "@types/js-cookie": "^3.0.6",
    "@types/k6": "^0.53.2",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "oxfmt": "^0.74.0",
    "postcss-preset-env": "^7.8.3",
    "rehype-video": "^2.3.1",
    "shared": "workspace:*",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-bundle-analyzer": "^1.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.0",
    "zero-cache": "workspace:*",
    "zqlite": "workspace:*"
  },
  "packageManager": "pnpm@11.11.0"
}
